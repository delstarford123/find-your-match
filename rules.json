{
  "rules": {
    ".read": false,
    ".write": false,

    "merchant_alerts": {
      "$restaurant_id": {
        ".read": true, 
        "$alert_id": {
          "status": {
            ".write": "newData.val() === 'read'"
          }
        }
      }
    },

    "party_participants": {
      ".read": true,
      ".write": true,
      ".indexOn": ["joined_at"]
    },

    "profiles": {
      "$user_id": {
        "is_online": {
          ".read": true,
          ".write": true
        },
        "last_active": {
          ".read": true,
          ".write": true
        }
      },
      ".indexOn": [
        "email", 
        "phone", 
        "referral_code", 
        "wingman_code", 
        "is_paid", 
        "is_online", 
        "gender", 
        "daily_streak", 
        "class_code", 
        "created_at", 
        "institution_name", 
        "institution_type",
        "crush_votes",
        "tribe"
      ]
    },

    "sponsor_profiles": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "email",
        "phone",
        "is_active",
        "is_verified",
        "gender"
      ]
    },
    
    "events_rsvps": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["event_id", "user_id"]
    },
    
    "notifications": {
      ".read": true,
      ".write": true,
      "$user_id": {
        ".indexOn": ["status", "timestamp"]
      }
    },
    
    "schedules": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["user_id"]
    },
    
    "swipes": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["user_id", "target_id", "timestamp"]
    },
    
    "bookings": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["restaurant_id", "user_a_id", "user_b_id", "status", "timestamp"]
    },
    
    "restaurants": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["subscription_active", "email"]
    },
    
    "matches": {
      ".read": true,
      ".write": true,
      ".indexOn": ["users"]
    },

    "messages": {
      ".read": true,
      ".write": true,
      "$match_id": {
        ".indexOn": ["timestamp"]
      }
    },

    "chats": {
      ".read": true,
      ".write": true,
      "$room_id": {
        ".indexOn": ["timestamp"]
      }
    },

    "confessions": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp", "score"]
    },

    "missed_connections": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp", "upvotes"]
    },

    "gossip": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp", "upvotes"]
    },

    "secret_crushes": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["status", "timestamp"]
    },

    "daily_prompts": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["date"]
    },

    "prompt_answers": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp"]
    },

    "admin_alerts": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp"]
    },
    
    "call_requests": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp", "status"]
    },
    
    "feedbacks": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp", "type"]
    },

    "call_reviews": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp", "quality"]
    },

    "admin_audit_logs": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp"]
    },

    "active_ads": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["status"]
    },

    "party_chat": {
      ".read": true,
      ".write": true,
      ".indexOn": ["timestamp_ms"]
    },

    "party_chat_main": {
      ".read": true,
      ".write": true,
      ".indexOn": ["timestamp_ms"]
    },

    "party_chat_dj": {
      ".read": true,
      ".write": true,
      ".indexOn": ["timestamp_ms"]
    },

    "party_chat_vip": {
      ".read": true,
      ".write": true,
      ".indexOn": ["timestamp_ms"]
    },

    "party_chat_chill": {
      ".read": true,
      ".write": true,
      ".indexOn": ["timestamp_ms"]
    },

    "party_chat_live_video": {
      ".read": true,
      ".write": true,
      ".indexOn": ["timestamp_ms"]
    },

    "party_typing": {
      ".read": true,
      ".write": true
    },
    
    "users": {
      "$user_id": {
        "is_online": {
          ".read": true,
          ".write": true
        }
      },
      ".indexOn": ["is_online"]
    },
    
    "lights_out_queue": {
      ".read": true,
      ".write": true,
      ".indexOn": ["timestamp"]
    },
    "lights_out_rooms": {
      ".read": true,
      ".write": true
    },
    "calls": {
      ".read": true,
      ".write": true
    },
    "incoming_calls": {
      ".read": true,
      ".write": true
    },
    "signals": {
      ".read": true,
      ".write": true
    },
    "emergency_alerts": {
      ".read": true,
      ".write": true,
      ".indexOn": ["timestamp"]
    },
    "campus_managers": {
      ".read": false,
      ".write": false,
      ".indexOn": ["email"]
    },
    "campus_manager_ledgers": {
      ".read": false,
      ".write": false
    },
    "groups": {
      ".read": true,
      ".write": true,
      ".indexOn": ["created_by", "name"]
    },
    "group_messages": {
      ".read": true,
      ".write": true
    },
    "chat_notifications": {
      ".read": true,
      ".write": true,
      ".indexOn": ["timestamp"]
    },
    "balloon_room": {
      ".read": true,
      ".write": true
    },
    "balloon_chat": {
      ".read": true,
      ".write": true,
      ".indexOn": ["timestamp"]
    },
    "events": {
      ".read": true,
      ".write": true,
      ".indexOn": ["created_at", "status", "category", "date"]
    },
    "events_rsvps": {
      ".read": true,
      ".write": true,
      ".indexOn": ["timestamp"]
    },
    "events_discussions": {
      ".read": true,
      ".write": true,
      ".indexOn": ["timestamp"]
    },
    "hotspots": {
      ".read": true,
      ".write": true,
      ".indexOn": ["name", "count"]
    },
    "hotspot_checkins": {
      ".read": true,
      ".write": true,
      ".indexOn": ["timestamp"]
    },
    "tickets_lookup": {
      ".read": true,
      ".write": true,
      ".indexOn": ["ticket_code", "event_id", "timestamp"]
    },
    "lovi_lookup": {
      ".read": true,
      ".write": true,
      ".indexOn": ["lovi_code", "ticket_code", "event_id"]
    },
    "pending_organizer_payouts": {
      ".read": true,
      ".write": true,
      ".indexOn": ["scheduled_at", "status", "event_id"]
    },
    "pending_event_payments": {
      ".read": true,
      ".write": true,
      ".indexOn": ["status", "event_id"]
    },
    "b2c_payout_results": {
      ".read": true,
      ".write": true,
      ".indexOn": ["result_code", "received_at"]
    }
  }
}