{
  "rules": {
    
    ".read": false,
    ".write": false,

    
    "merchant_alerts": {
      "$restaurant_id": {
        ".read": true, 
        "$alert_id": {
          "status": {
            ".write": "newData.val() === 'read'"
          }
        }
      }
    },

    
    "party_participants": {
      ".read": true,
      "$user_id": {
        ".write": "auth != null && auth.uid === $user_id",
        ".indexOn": ["joined_at", "shape_seed"]
      },
      ".indexOn": ["joined_at"]
    },


    "profiles": {
      ".read": "auth != null",
      ".indexOn": [
        "email", 
        "phone", 
        "referral_code", 
        "wingman_code", 
        "is_paid", 
        "is_online", 
        "gender", 
        "daily_streak", 
        "class_code", 
        "created_at", 
        "institution_name", 
        "institution_type",
        "crush_votes"
      ]
    },
    
    "notifications": {
      "$user_id": {
        ".indexOn": ["status", "timestamp"]
      }
    },
    
    "schedules": {
      ".indexOn": ["user_id"]
    },
    
    "swipes": {
      ".indexOn": ["user_id", "target_id", "timestamp"]
    },
    
    "bookings": {
      ".indexOn": ["restaurant_id", "user_a_id", "user_b_id", "status", "timestamp"]
    },
    
    "restaurants": {
      ".indexOn": ["subscription_active", "email"]
    },
    
    "matches": {
      ".indexOn": ["users"]
    },

    "messages": {
      "$match_id": {
        ".indexOn": ["timestamp"]
      }
    },

    "chats": {
      "$room_id": {
        ".indexOn": ["timestamp"]
      }
    },

    "confessions": {
      ".indexOn": ["timestamp", "score"]
    },

    "missed_connections": {
      ".indexOn": ["timestamp", "upvotes"]
    },

    "gossip": {
      ".indexOn": ["timestamp", "upvotes"]
    },

    "secret_crushes": {
      ".indexOn": ["status", "timestamp"]
    },

    "daily_prompts": {
      ".indexOn": ["date"]
    },

    "prompt_answers": {
      ".indexOn": ["timestamp"]
    },

    "admin_alerts": {
      ".indexOn": ["timestamp"]
    },
    
    "call_requests": {
      ".indexOn": ["timestamp", "status"]
    },
    
    "feedbacks": {
      ".indexOn": ["timestamp", "type"]
    },

    "call_reviews": {
      ".indexOn": ["timestamp", "quality"]
    },

    "admin_audit_logs": {
      ".indexOn": ["timestamp"]
    }
  }
}